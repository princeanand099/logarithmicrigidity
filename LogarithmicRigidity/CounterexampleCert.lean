private lemma tau_origin_nonDicritical :
    IsNonDicriticalTau (tauRatio (jacTr 0 0) (jacDet 0 0)) := by
  intro h
  have htr : jacTr (0 : ℂ) 0 = 4 := by
    simp only [jacTr]
    norm_num
  have hdet : jacDet (0 : ℂ) 0 = -190976 := by
    simp only [jacDet]
    norm_num
  have htau : tauRatio (jacTr 0 0) (jacDet 0 0) = ((-1 / 11936 : ℝ) : ℂ) := by
    rw [tauRatio, htr, hdet]
    push_cast
    norm_num
  have hre : (tauRatio (jacTr 0 0) (jacDet 0 0)).re = -1 / 11936 := by
    rw [htau, Complex.ofReal_re]
  linarith [h.2]

private lemma tau_posI_nonDicritical :
    IsNonDicriticalTau (tauRatio (jacTr 0 Complex.I) (jacDet 0 Complex.I)) := by
  intro h
  have hi2 : Complex.I ^ 2 = -1 := Complex.I_sq
  have hi3 : Complex.I ^ 3 = -Complex.I := by
    calc Complex.I ^ 3 = Complex.I ^ 2 * Complex.I := by ring
      _ = -Complex.I := by rw [hi2]; ring
  have htr : jacTr (0 : ℂ) Complex.I = -32 - 192 * Complex.I := by
    simp only [jacTr]
    rw [hi2, hi3]
    ring
  have hdet : jacDet (0 : ℂ) Complex.I = 283072 - 45600 * Complex.I := by
    simp only [jacDet]
    rw [hi2, hi3]
    ring_nf
    rw [hi2]
    ring
  have hdet_ne : jacDet (0 : ℂ) Complex.I ≠ 0 := by
    rw [hdet]
    intro h0
    have hre := congr_arg Complex.re h0
    simp at hre
  have htau : tauRatio (jacTr 0 Complex.I) (jacDet 0 Complex.I) =
      ((-282560 / 2169793 : ℝ) : ℂ) + ((48672 / 2169793 : ℝ) : ℂ) * Complex.I := by
    rw [tauRatio, div_eq_iff hdet_ne, htr, hdet]
    apply Complex.ext <;> simp [pow_two] <;> norm_num
  have him : (tauRatio (jacTr 0 Complex.I) (jacDet 0 Complex.I)).im = 48672 / 2169793 := by
    rw [htau]
    simp
  linarith [h.1]

private lemma tau_negI_nonDicritical :
    IsNonDicriticalTau (tauRatio (jacTr 0 (-Complex.I)) (jacDet 0 (-Complex.I))) := by
  intro h
  have hi2 : (-Complex.I) ^ 2 = -1 := by
    rw [neg_sq, Complex.I_sq]
  have hi3 : (-Complex.I) ^ 3 = Complex.I := by
    calc (-Complex.I) ^ 3 = (-Complex.I) ^ 2 * (-Complex.I) := by ring
      _ = Complex.I := by rw [hi2]; ring
  have htr : jacTr (0 : ℂ) (-Complex.I) = -32 + 192 * Complex.I := by
    simp only [jacTr]
    rw [hi2, hi3]
    ring
  have hdet : jacDet (0 : ℂ) (-Complex.I) = 283072 + 45600 * Complex.I := by
    simp only [jacDet]
    rw [hi2, hi3]
    ring_nf
    rw [Complex.I_sq]
    ring
  have hdet_ne : jacDet (0 : ℂ) (-Complex.I) ≠ 0 := by
    rw [hdet]
    intro h0
    have hre := congr_arg Complex.re h0
    simp at hre
  have htau : tauRatio (jacTr 0 (-Complex.I)) (jacDet 0 (-Complex.I)) =
      ((-282560 / 2169793 : ℝ) : ℂ) + ((-48672 / 2169793 : ℝ) : ℂ) * Complex.I := by
    rw [tauRatio, div_eq_iff hdet_ne, htr, hdet]
    apply Complex.ext <;> simp [pow_two] <;> norm_num
  have him : (tauRatio (jacTr 0 (-Complex.I)) (jacDet 0 (-Complex.I))).im = -48672 / 2169793 := by
    rw [htau]
    simp
  linarith [h.1]

/-- **Proposition 6.2**: Cofactor identity, elimination, and non-dicriticality (`τ ∉ [4, ∞)`)
across all 13 singularities of the explicit degree-3 system (6.2). -/
theorem prop_6_2_counterexample_nondicritical :
    (∀ x y : ℂ, vecP x y * quarticFx x y + vecQ x y * quarticFy x y =
      cofactorK x y * quarticF x y) ∧
    (∀ x : ℝ, 0 < q4Poly x) ∧
    (∀ τ : ℝ, 0 < M4Poly τ) ∧
    (∀ τ : ℝ, 4 ≤ τ → 0 < M6Poly τ) ∧
    IsNonDicriticalTau (tauRatio (jacTr 0 0) (jacDet 0 0)) ∧
    IsNonDicriticalTau (tauRatio (jacTr 0 Complex.I) (jacDet 0 Complex.I)) ∧
    IsNonDicriticalTau (tauRatio (jacTr 0 (-Complex.I)) (jacDet 0 (-Complex.I))) := by
  refine ⟨?_, q4Poly_pos, M4Poly_pos, M6Poly_pos_of_ge_four,
    tau_origin_nonDicritical, tau_posI_nonDicritical, tau_negI_nonDicritical⟩
  intro x y
  simp only [vecP, vecQ, quarticFx, quarticFy, cofactorK, quarticF]
  ring

private lemma H2Scaled_one_pos (y : ℝ) (hy0 : 0 ≤ y) (hy1 : y ≤ 1) : 0 < H2Scaled 1 y := by
  have h : H2Scaled 1 y =
      21565 * y ^ 5 + 237210 * y ^ 4 * (1 - y) + 307898 * y ^ 3 * (1 - y) ^ 2 +
      253784 * y ^ 2 * (1 - y) ^ 3 + 148481 * y * (1 - y) ^ 4 + 35910 * (1 - y) ^ 5 := by
    simp only [H2Scaled, cofactorK, vecP, vecQ]
    ring
  rw [h]
  rcases le_or_gt y (1 / 2 : ℝ) with hy | hy
  · have h1y : 0 < 1 - y := by linarith
    positivity
  · have hy' : 0 < y := by linarith
    have h1y : 0 ≤ 1 - y := by linarith
    positivity

