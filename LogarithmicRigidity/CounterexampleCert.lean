private lemma q4Poly_pos (x : ℝ) : 0 < q4Poly x := by
  have h : (160 : ℝ) * q4Poly x =
      160 * (48 * x ^ 2 - 460 * x + 1470) ^ 2 + (160 * x - 1068) ^ 2 + 282256 := by
    simp only [q4Poly]
    ring
  nlinarith [sq_nonneg (48 * x ^ 2 - 460 * x + 1470), sq_nonneg (160 * x - 1068)]

