  unfold M6Poly; push_cast; ring

/-- **Proposition 6.2 (`q₆` Stratum Non-Dicriticality)**: Every complex affine singularity
`(x, y)` of `(P, Q)` (6.2) with `q₆(x) = 0` is non-degenerate (`jacDet x y ≠ 0`) and
satisfies `τ(x, y) ∉ [4, ∞)` (`IsNonDicriticalTau`). -/
theorem prop_6_2_q6_stratum_nondicritical (x y : ℂ)
    (hP : vecP x y = 0) (hQ : vecQ x y = 0) (hq : q6Poly x = 0) :
    jacDet x y ≠ 0 ∧ IsNonDicriticalTau (tauRatio (jacTr x y) (jacDet x y)) := by
  have hy := q6_y_eq x y hP hQ hq
  subst hy
  rcases q6_det_and_M6 x hq with ⟨hdet, hM6⟩
  refine ⟨hdet, ?_⟩
  rintro ⟨him, hre⟩
  set τ := tauRatio (jacTr x (y6Expr x)) (jacDet x (y6Expr x))
  have hτ : τ = (τ.re : ℂ) := Complex.ext rfl (by simpa using him)
  rw [hτ, complex_ofReal_M6] at hM6
  have hM6_real : M6Poly τ.re = 0 := Complex.ofReal_eq_zero.mp hM6
  have hpos : 0 < M6Poly τ.re := prop_6_2_counterexample_nondicritical.2.2.2.1 τ.re hre
  linarith

private lemma jacDet_zero_zero_ne : jacDet (0 : ℂ) 0 ≠ 0 := by
  unfold jacDet; norm_num

private lemma jacDet_zero_sq_add_one (y : ℂ) (hy : y ^ 2 + 1 = 0) :
    jacDet (0 : ℂ) y = 283072 - 45600 * y := by
  have hid : jacDet (0 : ℂ) y - (283072 - 45600 * y) =
      (9216 * y ^ 4 + 3456 * y ^ 3 - 148320 * y ^ 2 + 69168 * y - 474048) * (y ^ 2 + 1) := by
    unfold jacDet; ring
  exact sub_eq_zero.mp (by rw [hid, hy, mul_zero])

private lemma jacDet_zero_I_ne : jacDet (0 : ℂ) Complex.I ≠ 0 := by
  have hsq : Complex.I ^ 2 + 1 = 0 := by linear_combination Complex.I_sq
  rw [jacDet_zero_sq_add_one Complex.I hsq]
  intro h0
  have := congr_arg Complex.re h0
  simp at this

private lemma jacDet_zero_neg_I_ne : jacDet (0 : ℂ) (-Complex.I) ≠ 0 := by
  have hsq : (-Complex.I) ^ 2 + 1 = 0 := by linear_combination Complex.I_sq
  rw [jacDet_zero_sq_add_one (-Complex.I) hsq]
  intro h0
  have := congr_arg Complex.re h0
  simp at this

/-- **Proposition 6.2 (Complete End-to-End Affine Non-Dicriticality Certification)**:
Every complex affine singularity `(x, y)` of the degree-3 counterexample `(P, Q)` (6.2)
across all three elimination strata (`x = 0`, `q₄(x) = 0`, `q₆(x) = 0`) is non-degenerate
(`jacDet x y ≠ 0`) and satisfies `τ(x, y) ∉ [4, ∞)` (`IsNonDicriticalTau`). -/
theorem prop_6_2_all_affine_singularities_nondicritical (x y : ℂ)
    (hP : vecP x y = 0) (hQ : vecQ x y = 0) :
    jacDet x y ≠ 0 ∧ IsNonDicriticalTau (tauRatio (jacTr x y) (jacDet x y)) := by
  rcases sing_PQ_elim x y hP hQ with rfl | hq4 | hq6
  · rcases sing_PQ_x_zero y hP hQ with rfl | rfl | rfl
    · exact ⟨jacDet_zero_zero_ne, prop_6_2_counterexample_nondicritical.2.2.2.2.1⟩
    · exact ⟨jacDet_zero_I_ne, prop_6_2_counterexample_nondicritical.2.2.2.2.2.1⟩
    · exact ⟨jacDet_zero_neg_I_ne, prop_6_2_counterexample_nondicritical.2.2.2.2.2.2⟩
  · exact prop_6_2_q4_stratum_nondicritical x y hP hQ hq4
  · exact prop_6_2_q6_stratum_nondicritical x y hP hQ hq6

end LogarithmicRigidity
